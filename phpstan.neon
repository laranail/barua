includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    paths:
        - src
        - config
        - routes

    ignoreErrors:
        # larastan validates view-string literals against a skeleton app that never boots this
        # package's provider, so the `laranail/barua::` namespace registered at runtime is
        # invisible to it. The views exist; the feature suite renders every one of them.
        - '#expects view-string, string given#'
        - '#view-string\|null, string given#'

        # env() is exactly what belongs in a config file.
        -
            identifier: larastan.noEnvCallsOutsideOfConfig
            path: config/barua.php

    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: false
