{
    "name": "laranail/barua",
    "description": "Responsive, un-styled Blade email components and a fluent mail builder for Laravel.",
    "keywords": ["laravel", "email", "mail", "blade", "components", "laranail"],
    "license": "MIT",
    "homepage": "https://opensource.simtabi.com/products/laranail/barua",
    "support": {
        "issues": "https://github.com/laranail/barua/issues",
        "source": "https://github.com/laranail/barua",
        "docs": "https://opensource.simtabi.com/documentation/laranail/barua/"
    },
    "authors": [
        {
            "name": "Imani Manyara",
            "email": "imani@simtabi.com",
            "homepage": "https://simtabi.com",
            "role": "Maintainer"
        }
    ],
    "repositories": [
        { "type": "vcs", "url": "https://github.com/laranail/package-tools" },
        { "type": "composer", "url": "https://repo.packagist.org", "exclude": ["laranail/*"] },
        { "packagist.org": false }
    ],
    "require": {
        "php": "^8.4.1 || ^8.5",
        "ext-dom": "*",
        "ext-fileinfo": "*",
        "ext-libxml": "*",
        "illuminate/bus": "^13.0",
        "illuminate/config": "^13.0",
        "illuminate/container": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/events": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/log": "^13.0",
        "illuminate/mail": "^13.0",
        "illuminate/queue": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/view": "^13.0",
        "laranail/package-tools": "^0.1",
        "laravel/framework": "^13.0",
        "tijsverkoyen/css-to-inline-styles": "^2.2"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.30",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/phpstan": "^2.0",
        "rector/rector": "^2.5.8",
        "roave/security-advisories": "dev-latest"
    },
    "autoload": {
        "psr-4": {
            "Simtabi\\Laranail\\Barua\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Simtabi\\Laranail\\Barua\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest --colors=always",
        "test-coverage": "@test --coverage",
        "pint": "@php vendor/bin/laranail-pint --test",
        "pint-fix": "@php vendor/bin/laranail-pint --parallel",
        "phpstan": "vendor/bin/phpstan analyse --no-progress",
        "analyse": "@phpstan",
        "rector": "vendor/bin/rector process --dry-run",
        "rector-fix": "vendor/bin/rector process",
        "lint": [
            "@pint",
            "@phpstan",
            "@rector"
        ],
        "composer-audit": "@composer audit",
        "format": "@pint-fix"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Simtabi\\Laranail\\Barua\\Providers\\BaruaServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
